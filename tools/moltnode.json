{
 "server": "MoltNode by Chord",
 "checked": "2026-10-17",
 "tools": [
  {
   "name": "chord_find_token",
   "title": "Find a token (Chord)",
   "description": "Find a token by symbol, name or address on a chain Chord trades on (base, ethereum, monad, bnb, avalanche, arbitrum, robinhood, arc). Returns addresses, decimals and whether the token is verified; similar tickers are common, so compare addresses.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "chain": {
      "type": "string",
      "enum": [
       "base",
       "ethereum",
       "monad",
       "bnb",
       "avalanche",
       "arbitrum",
       "robinhood",
       "arc"
      ],
      "description": "Chord chain key."
     },
     "query": {
      "type": "string",
      "description": "Symbol, name or 0x address."
     }
    },
    "required": [
     "chain",
     "query"
    ],
    "additionalProperties": false
   },
   "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true
   }
  },
  {
   "name": "chord_swap_quote",
   "title": "Swap quote and unsigned transaction (Chord)",
   "description": "Best swap route from Chord (getchord.xyz) across the DEXs of the chain, with the UNSIGNED transaction to sign, the ERC-20 approval it needs (as a ready transaction) and a simulation run from the taker wallet. Amounts are integer strings in the token's smallest unit; the zero address is the native coin. Nothing is sent: sign with your own key, then send_raw_transaction.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "chain": {
      "type": "string",
      "enum": [
       "base",
       "ethereum",
       "monad",
       "bnb",
       "avalanche",
       "arbitrum",
       "robinhood",
       "arc"
      ],
      "description": "Chord chain key."
     },
     "tokenIn": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$",
      "description": "Token sold (zero address = native coin)."
     },
     "tokenOut": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$",
      "description": "Token bought (zero address = native coin)."
     },
     "amount": {
      "type": "string",
      "pattern": "^[0-9]+$",
      "description": "Amount of tokenIn in its smallest unit, e.g. '10000000' = 10 USDC."
     },
     "taker": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$",
      "description": "The wallet that will sign. With it the answer carries tx + approval + a simulation from that wallet."
     },
     "slippageBps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5000,
      "description": "Slippage in basis points (default 50)."
     }
    },
    "required": [
     "chain",
     "tokenIn",
     "tokenOut",
     "amount"
    ],
    "additionalProperties": false
   },
   "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true
   }
  },
