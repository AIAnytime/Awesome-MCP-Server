     "date_start",
     "date_end"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
   },
   "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true
   }
  },
  {
   "name": "drives_host_showroom",
   "title": "Host showroom profile",
