 "tools": [
  {
   "name": "drives_airport_search",
   "title": "Airport search",
   "description": "Search airports for delivery pickup with delivery fee information.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "query": {
      "type": "string",
      "description": "Airport name or IATA code to search"
     },
     "limit": {
      "type": "integer",
      "description": "Maximum results"
     }
    },
    "required": [
     "query"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
   },
   "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true
   }
  },
  {
   "name": "drives_get_quote",
   "title": "Get rental quote",
   "description": "Calculate a full rental quote including daily breakdown, taxes, deposit, and total for a date range.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "asset_rental_id": {
      "type": "string",
